{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/frontend/$1"
    },
    {
      "source": "/css/(.*)",
      "destination": "/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    },
    {
      "source": "/mobile",
      "destination": "/frontend/mobile.html"
    },
    {
      "source": "/mobile.html",
      "destination": "/frontend/mobile.html"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    }
  ]
}
