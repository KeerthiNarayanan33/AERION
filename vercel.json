{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": "frontend",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/mobile",
      "destination": "/mobile.html"
    },
    {
      "source": "/mobile.html",
      "destination": "/mobile.html"
    }
  ]
}
