# ==============================================================================
# AI-Powered Multi-Sensor Border Surveillance - Environment Configuration
# ==============================================================================

# System Operation Mode: REAL or SIMULATED
SYSTEM_MODE=SIMULATED

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Hardware: Camera Settings
CAMERA_DEFAULT_INDEX=0
CAMERA_FPS=30
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720

# AI Detection & Tracking Configuration
AI_INFERENCE_FPS=15
DETECTION_CONFIDENCE=0.50
YOLO_MODEL_NAME=yolov8n.pt
TRACKING_ENABLED=True

# Hardware: Radar & ESP32 Configuration
RADAR_ENABLED=True
RADAR_PORT=8080
RADAR_SERIAL_PORT=COM3
RADAR_BAUD_RATE=256000
ESP32_IP=10.146.49.50

# Storage & Event Engine Configuration
STORAGE_DIR=storage
DATABASE_URL=sqlite:///./storage/surveillance.db
PRE_EVENT_SECONDS=10
POST_EVENT_SECONDS=15
RETENTION_DAYS=14
EVENT_COOLDOWN_SECONDS=10

# Sensor Fusion Parameters
FUSION_DISTANCE_THRESHOLD=2.5
FUSION_RADAR_WEIGHT=0.6
FUSION_VISION_WEIGHT=0.4
